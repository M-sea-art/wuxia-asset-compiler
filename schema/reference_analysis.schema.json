{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M-sea-art/wuxia-asset-compiler/schema/reference_analysis.schema.json",
  "title": "Wuxia Reference Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_version",
    "factory_candidate",
    "factory_confidence",
    "camera",
    "parameter_estimates",
    "observations",
    "uncertainties"
  ],
  "properties": {
    "analysis_version": {"type": "integer", "const": 1},
    "factory_candidate": {
      "type": "string",
      "enum": ["cliff_ground_floor", "cliff_kitchen"]
    },
    "factory_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "azimuth_deg", "elevation_deg", "confidence"],
      "properties": {
        "projection": {
          "type": "string",
          "enum": ["orthographic_like", "perspective", "unknown"]
        },
        "azimuth_deg": {"type": "number", "minimum": 0.0, "exclusiveMaximum": 360.0},
        "elevation_deg": {"type": "number", "minimum": -10.0, "maximum": 89.0},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "parameter_estimates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"$ref": "#/$defs/numberEstimate"},
        "depth": {"$ref": "#/$defs/numberEstimate"},
        "wall_height": {"$ref": "#/$defs/numberEstimate"},
        "roof_pitch_deg": {"$ref": "#/$defs/numberEstimate"},
        "eave_overhang": {"$ref": "#/$defs/numberEstimate"},
        "platform_height": {"$ref": "#/$defs/numberEstimate"},
        "cliff_embed": {"$ref": "#/$defs/numberEstimate"},
        "stone_step_count": {"$ref": "#/$defs/numberEstimate"},
        "post_count_x": {"$ref": "#/$defs/numberEstimate"},
        "wood_age": {"$ref": "#/$defs/numberEstimate"},
        "tile_damage": {"$ref": "#/$defs/numberEstimate"},
        "moss": {"$ref": "#/$defs/numberEstimate"}
      }
    },
    "room_estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["room_id", "parameter_estimates"],
        "properties": {
          "room_id": {"type": "string", "minLength": 1},
          "parameter_estimates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {"$ref": "#/$defs/numberEstimate"},
              "lantern_count": {"$ref": "#/$defs/numberEstimate"},
              "occupancy": {"$ref": "#/$defs/numberEstimate"},
              "clutter": {"$ref": "#/$defs/numberEstimate"}
            }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "statement", "confidence"],
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "numberEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": {"type": "number"},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
