{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M-sea-art/wuxia-asset-compiler/schema/visual_review.schema.json",
  "title": "Wuxia Visual QA Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_version",
    "factory",
    "scores",
    "parameter_patches",
    "room_patches",
    "template_gaps",
    "summary"
  ],
  "properties": {
    "review_version": {"type": "integer", "const": 1},
    "factory": {
      "type": "string",
      "enum": ["cliff_ground_floor", "cliff_kitchen"]
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "room_identity",
        "semantic_density",
        "lighting",
        "material_style"
      ],
      "properties": {
        "composition": {"type": "number", "minimum": 0, "maximum": 1},
        "room_identity": {"type": "number", "minimum": 0, "maximum": 1},
        "semantic_density": {"type": "number", "minimum": 0, "maximum": 1},
        "lighting": {"type": "number", "minimum": 0, "maximum": 1},
        "material_style": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "parameter_patches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"$ref": "#/$defs/numberPatch"},
        "depth": {"$ref": "#/$defs/numberPatch"},
        "wall_height": {"$ref": "#/$defs/numberPatch"},
        "roof_pitch_deg": {"$ref": "#/$defs/numberPatch"},
        "eave_overhang": {"$ref": "#/$defs/numberPatch"},
        "platform_height": {"$ref": "#/$defs/numberPatch"},
        "cliff_embed": {"$ref": "#/$defs/numberPatch"},
        "stone_step_count": {"$ref": "#/$defs/numberPatch"},
        "post_count_x": {"$ref": "#/$defs/numberPatch"},
        "wood_age": {"$ref": "#/$defs/numberPatch"},
        "tile_damage": {"$ref": "#/$defs/numberPatch"},
        "moss": {"$ref": "#/$defs/numberPatch"}
      }
    },
    "room_patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["room_id", "parameter_patches"],
        "properties": {
          "room_id": {"type": "string", "minLength": 1},
          "parameter_patches": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {"$ref": "#/$defs/numberPatch"},
              "lantern_count": {"$ref": "#/$defs/numberPatch"},
              "occupancy": {"$ref": "#/$defs/numberPatch"},
              "clutter": {"$ref": "#/$defs/numberPatch"}
            }
          }
        }
      }
    },
    "template_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "capability", "severity", "evidence", "recommendation"],
        "properties": {
          "scope": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "severity": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "numberPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": {"type": "number"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
